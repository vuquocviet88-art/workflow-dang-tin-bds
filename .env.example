# OPENROUTER_API_KEY: Required for AI calls (https://openrouter.ai/keys).
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# AI_MODEL: optional, OpenRouter model id. Default: anthropic/claude-sonnet-5.5
# AI_MODEL="anthropic/claude-sonnet-5.5"
# AI_FALLBACK_MODEL: optional, second model tried if the first fails.
# OPENROUTER_BASE_URL: optional, defaults to https://openrouter.ai/api/v1

# APP_URL: The public URL of the app (sent to OpenRouter as HTTP-Referer).
APP_URL="MY_APP_URL"

# AI goes through any OpenAI-compatible API. Set the key (required) and optionally the provider.
# Default provider is OpenRouter (https://openrouter.ai/keys). For RevidAPI:
#   AI_BASE_URL="https://revidapi.com/v1"   AI_MODEL="claude-sonnet-5-5"
AI_API_KEY="MY_API_KEY"

# AI_BASE_URL: optional, defaults to https://openrouter.ai/api/v1
# AI_MODEL: optional, default anthropic/claude-sonnet-5.5 (OpenRouter id; RevidAPI uses claude-sonnet-5-5)
# AI_FALLBACK_MODEL: optional, second model tried if the first fails
# AI_SCHEMA_MODE: optional "native" | "prompt". Default: native on openrouter.ai, prompt elsewhere
#   (RevidAPI ignores response_format, so the JSON schema is put into the prompt instead).
# OPENROUTER_API_KEY / OPENROUTER_BASE_URL still work as aliases.

# APP_URL: public URL of the app (sent as HTTP-Referer).
APP_URL="MY_APP_URL"
